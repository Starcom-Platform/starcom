# Refuse to INSTALL on a Node that does not satisfy package.json "engines".
#
# Scope matters: this gates `npm install`, not `npm run`. It is half the fix,
# and the other half is scripts/guard-node-version.mjs in the build chain.
#
# .nvmrc pins 22.12.0, package.json requires >=22.12.0, and CI reads .nvmrc —
# so the only place the version could drift was a developer shell, and it did.
# An entire working session ran against the system Node 18.16.0 without a word
# of complaint: vitest passed with intermittent "parallel load" flakes that were
# really an unsupported runtime, and the whole Playwright suite was dead,
# failing every spec with an .esm.preflight error because Playwright 1.58 needs
# module.register(), added in Node 18.19.
engine-strict=true
