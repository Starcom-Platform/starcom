# Large data files
*.csv
# …except test fixtures: small, deliberate, and read by tests with fs rather than
# imported, so the untracked-imports guard cannot see one go missing — the test
# would pass locally and fail in every clean clone.
!src/**/__tests__/fixtures/*.csv
*.json.bak
*.db
*.sqlite
*.sqlite3
technical_reference_code_samples/NOAA_directory_scan/noaa_data/*.json
test-results/screenshots/
**/*.venv/
**/backup/

# Ignore EEZ tmp large exports
data/eez/tmp/*.json

# Publication candidates — signed locally for review, never committed.
candidate/

# Build-generated discovery surface. Regenerated by scripts/publish-*.mjs on
# every build, including on the deploy host, so committing them would only
# create churn and let a stale copy disagree with what is served.
public/spec/
public/.well-known/starcom-health.json
# What a Vercel build was built from, and the Ignored Build Step's note of it (scripts/vercel-build-input.mjs).
public/.well-known/starcom-build-input.json
.vercel-build-input.json
public/.well-known/starcom-node.json
# Copied from src/config/publishers.json by scripts/publish-node-descriptor.mjs at every build.
public/.well-known/starcom-publishers.json
public/.well-known/starcom-guards.json
# A day of GDELT events, fetched by scripts/snapshot-gdelt.mjs on every build.
# It lists the GDELT windows it came from, so it can be rebuilt from GDELT's
# archive; committing it would put 2.8 MB of yesterday into every clone.
public/data/gdelt-events.json
# Threat indicators, sampled and located by scripts/snapshot-threats.mjs on every build.
public/data/threat-indicators.json
# OFAC's sanctions changes of the last 30 days, counted by scripts/snapshot-ofac.mjs on every build.
public/data/sanctions-changes.json
# OFAC's SDN list counted by country (scripts/snapshot-ofac.mjs), for Diplomacy's country brief.
public/data/sanctions-by-country.json
# HHS-OIG's last three monthly exclusion supplements, counted by scripts/snapshot-leie.mjs on every build.
public/data/health-exclusions.json

# Node publishing identity. Contains the secret key that signs Starcom's
# attested claims. Never commit.
.starcom-identity.json
public/.well-known/nostr.json

# starcom-desktop is a submodule; its own build output must not be tracked here
desktop/node_modules/
desktop/dist/

# Heap snapshots. A 61MB profiling artefact in every clone forever, and this one
# happened to contain two bot tokens from the environment it was captured in —
# a heap dump holds whatever was in memory, which is the whole point of it.
*.heapsnapshot
artifacts/memory-smoke/

# Starcom Uplink (decision D-EX): its build output and generated types
extension/.output
extension/.wxt
