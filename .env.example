# ── Starcom Environment Variables ──
# Copy to .env and fill in values. Only VITE_ vars are exposed to the client.

# Starcom ships no analytics, and a build guard keeps it that way, so there are no analytics settings.

# ── Deployment / Build ──
VITE_TARGET=vercel                  # vercel | ipfs
VITE_ROUTER_MODE=browser            # browser | hash
VITE_DEPLOYMENT_DEBUG=false
VITE_SHOW_STORAGE_BADGE=true

# ── API Keys (optional — features degrade gracefully if unset) ──
VITE_EIA_API_KEY=
VITE_WEB3_STORAGE_TOKEN=
# REMOVED — VITE_TELEGRAM_BOT_TOKEN. VITE_* values are compiled into the shipped
# bundle, and a bot token grants control of the bot. The widget takes it from
# runtime config (window.STARCOM_TELEGRAM_CONFIG) instead, which keeps it out of
# the build. Note Telegram puts the token in the URL path, so even then it
# reaches browser history and proxy logs — a server-side proxy is the real fix.
VITE_TELEGRAM_CHANNEL_ID=
# REMOVED — VITE_DISCORD_BOT_TOKEN.
# Vite compiles VITE_* values into the shipped bundle, so this was public by
# construction. A bot token grants control of the bot. The Discord widget now
# uses the public widget.json endpoint, which needs no credential.
VITE_OPENWEATHERMAP_API_KEY=
VITE_N2YO_API_KEY=
VITE_ALPHA_VANTAGE_API_KEY=
# UCDP conflict data requires an access token; without it the source is not
# registered at all (the API returns 401).
# REMOVED — VITE_UCDP_ACCESS_TOKEN. UCDP is ingested from a static CC BY 4.0
# asset (npm run data:ucdp), which needs no credential and lets a fork run the
# same ingest without asking anyone for access.

# ── Optional CORS proxy ──
# Prefix for upstreams that do not send CORS headers. Unset = requests go
# direct. Previously hardcoded to http://localhost:8081/, which broke every
# consumer outside a dev machine running that proxy.
VITE_CORS_PROXY_URL=

# ── API URLs (leave unset unless you run such a service) ──
# Starcom runs no server, and there is no public api.starcom.app. Set one only if
# you run a compatible service yourself.
VITE_ALERTS_API_URL=
VITE_SPACE_ASSETS_API_URL=
VITE_RELIEF_WEB_API_URL=
VITE_GDACS_API_URL=
VITE_GEO_EVENTS_API_URL=

# ── Demo / Development ──
# VITE_DEMO_MODE=true       # Load Operation Blackout sample data in production builds

# ── Nostr relays ──
# Every channel follows one rule (src/services/nostr/publishTargets.ts):
# VITE_NOSTR_<CHANNEL>_RELAYS ADDS relays to the built-in set, and
# VITE_NOSTR_<CHANNEL>_RELAYS_EXCLUSIVE=true uses ONLY them.

# Intel: comma-separated wss:// URLs, read onto the globe and published to,
# in addition to the app's built-in relay set.
# VITE_NOSTR_INTEL_RELAYS=wss://relay.example.internal

# Intel search (NIP-50), used only when VITE_NOSTR_INTEL_ENABLE_SEARCH=true.
# This one REPLACES the default: it names which relays can search.
# VITE_NOSTR_INTEL_SEARCH_RELAYS=wss://relay.example.internal

# Chat: team channels, direct messages and prekey bundles. With
# _EXCLUSIVE=true chat uses only these relays, and emergency mode adds no
# public relays to it.
# VITE_NOSTR_CHAT_RELAYS=wss://relay.example.internal
# VITE_NOSTR_CHAT_RELAYS_EXCLUSIVE=true

# Findings: published and read.
# VITE_NOSTR_FINDING_RELAYS=wss://relay.example.internal

# The team's internal relays: access-controlled, reached through the tunnel.
# Declared, never inferred. Starcom signs in (NIP-42) only to these, and calls
# them Internal, not Public, wherever it says where something goes. Declaring
# one sends nothing there; add it to a channel above as well.
# VITE_NOSTR_INTERNAL_RELAYS=wss://relay.example.internal

# Mission Package PUBLISH: comma-separated wss:// URLs to broadcast signed
# Mission Packages to. Point this at the AI Security Relay Node's internal
# relay to have Starcom publish back to the same surface Mecha Jono and the
# Beus publish from. ADDITIVE by default — configured relays are appended to
# the public Navcom surface, not substituted for it, so a package doesn't
# become invisible to Navcom by being sent only internally.
# VITE_NOSTR_MISSION_RELAYS=wss://relay.example.internal

# Publish ONLY to VITE_NOSTR_MISSION_RELAYS, skipping the public relays.
# Correct for an air-gapped or internal-only deployment; deliberately an
# explicit opt-in so you can't get it by accident from setting the var above.
# VITE_NOSTR_MISSION_RELAYS_EXCLUSIVE=true

# Zone Guardian and Rescue Ranger role filters. Off by default: every marker
# currently resolves to `hero`, so offering them empties the globe, which reads
# as lost data rather than an unbuilt feature. Turn on when the registration
# path populates real roles.
VITE_RLSH_ROLE_CLASSES_ENABLED=false
