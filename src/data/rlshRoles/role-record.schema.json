{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://starcom.app/schemas/rlsh-role-record.schema.json",
  "title": "RLSH Curated Role Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "approved",
    "reviewedBy",
    "reviewedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "approved": {
      "type": "boolean"
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "notes": {
      "type": "string"
    },
    "nostrNpub": {
      "type": "string",
      "pattern": "^npub1[ac-hj-np-z02-9]{20,}$"
    },
    "contactEmail": {
      "type": "string",
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "socialLinks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://"
      }
    },
    "contactConsent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nostr": { "type": "boolean" },
        "email": { "type": "boolean" },
        "social": { "type": "boolean" }
      }
    }
  }
}
