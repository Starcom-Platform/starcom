95],[47.763,43.9284],[47.867,43.9914],[47.6657,43.9963],[47.6282,43.9626]]],[[[50.326,40.4581],[50.3587,40.4242],[50.3537,40.3999],[50.3963,40.4085],[50.3537,40.4807],[50.3264,40.4819],[50.326,40.4581]]],[[[50.563,40.3249],[50.5876,40.3006],[50.6257,40.3104],[50.6069,40.3378],[50.5653,40.3378],[50.563,40.3249]]]]},"properties":{"id":"zone:caucasus","level":"zone","parent":null,"class":"anchor","condition":"frame","state":"null","lifecycle":"standing","precision":"approximate","version":1,"countries":["am","az","ge","ru"],"sources":[{"name":"Starcom: zone:caucasus (src/features/globe/areas/areaRegistry.ts)","for":"the Zone's meaning: between the Black and Caspian seas, from the Kuma–Manych Depression to the Aras"},{"name":"Natural Earth 1:10m admin-0 countries (v5)","url":"https://www.naturalearthdata.com/","licence":"public domain","for":"coasts and the borders with Turkey and Iran; the countries each Sector touches"},{"name":"Natural Earth 1:10m rivers and lake centrelines, and its Europe supplement","url":"https://www.naturalearthdata.com/","licence":"public domain","for":"the Don, the Manych (in part), the Terek and the Sulak"},{"name":"GeoNames","url":"https://www.geonames.org/","licence":"CC BY 4.0","for":"landmarks (cited by id); the passes, peaks and river points the drawn lines pass through"},{"name":"General physical geography of the Caucasus (drawn by judgement)","for":"the watershed and range crests, the mountain fronts, the Manych where Natural Earth lacks it, the Kuma"}],"label":{"lon":44.4143,"lat":42.8244},"bbox":[36.5781,38.396,50.6257,47.249],"vertices":569,"style":{"theme":"anchor"},"name":"Caucasus Zone","frame":"geological","canon":"Caucasus Zone","principle":"Geology: the Caucasus mountain system between the Black and Caspian seas, from the Kuma–Manych Depression to the Aras, as Starcom's area has it: the Greater Caucasus fold belt, the Lesser Caucasus and Armenian volcanic highland, the Rioni and Kura troughs between them and the foreland to the north. Sectors follow ridgelines (the main watershed, the Likhi, Meskheti and Trialeti ranges), mountain fronts and rivers, never a border; no Sector names a state or a disputed territory, and the Zone ends at the Kerch Strait.","measures":{"area_km2":461458.2,"simplify_tolerance_deg":0.01,"densify_deg":0.25,"min_part_km2":5,"partition":{"faces":63,"land_faces":51,"regions":7},"natural_earth_units":["ARM","AZE","GEO","RUS"],"left_out":"Natural Earth's Russian part holding the Crimean peninsula","dropped":{"parts":0,"parts_km2":0,"holes":0,"holes_km2":0},"simplify":{"arcs":29,"segments_refined":0,"collapsed_parts":0,"collapsed_holes":0,"collapsed_km2":0},"vertices_in_document":1539},"declared":[{"kind":"transition","name":"Northern mountain front (Anapa to the Sulak)","precision":"approximate","note":"The Greater Caucasus' northern front is a band of foothills 10-40 km wide, not a line; it is drawn by judgement between the mountain-foot towns (Maykop, Cherkessk, Kislovodsk, Nalchik, Grozny, which lie in this Sector) and the plain's (Krymsk, Belorechensk, Labinsk, Pyatigorsk, Prokhladny, which do not), then along the Terek below Mozdok."},{"kind":"transition","name":"Karabakh piedmont (Goranboy to Horadiz)","precision":"approximate","note":"The edge between the Lesser Caucasus and the Kura–Aras Lowland is the foot of the Murovdag and Karabakh ranges: a piedmont band, drawn by judgement west of Tartar, Aghdam and Fuzuli to the Aras by Horadiz. It runs near, but neither follows nor stands for, the boundary of the former Nagorno-Karabakh Autonomous Oblast or the 1994-2020 line of contact."}]}},{"type":"Feature","id":"zone:caucasus/sector:north-caucasus-foreland","geometry":{"type":"MultiPolygon","coordinates":[[[[37.3289,44.8239],[37.45,44.83],[37.6333,44.8467],[37.8167,44.8633],[38,44.88],[38.22,44.844],[38.44,44.808],[38.66,44.772],[38.88,44.736],[39.1,44.7],[39.3,44.71],[39.5,44.72],[39.675,44.715],[39.85,44.71],[40.1,44.66],[40.31,44.6333],[40.52,44.6067],[40.73,44